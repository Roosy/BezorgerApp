<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BezorgerApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BezorgerApp"
    xmlns:View="clr-namespace:BezorgerApp.Views"
    Title="BezorgerApp">

    <ShellContent
    Title="Home"
    ContentTemplate="{DataTemplate local:MainPage}"
    Route="MainPage" />

    <ShellContent
    Title="Berichten"
    ContentTemplate="{DataTemplate View:PageNonExistent}"
    Route="BerichtenPage" />

    <ShellContent
    Title="Profiel"
    ContentTemplate="{DataTemplate View:PageNonExistent}"
    Route="ProfielPage" />

</Shell>
