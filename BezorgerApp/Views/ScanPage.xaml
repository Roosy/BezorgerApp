<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BezorgerApp.Views.ScanPage"
             Title="Pakketten scannen">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Pakketten scannen"
                   FontSize="24"
                   HorizontalOptions="Center" />

            
            <Border Stroke="#E0E0E0"
                    StrokeThickness="1">

                <VerticalStackLayout Padding="16" Spacing="12">

                    <Label Text="Barcode scanner"
                           FontAttributes="Bold"
                           FontSize="18" />

                    <Border Stroke="#D0D0D0"
                            StrokeThickness="1"
                            StrokeDashArray="4,4"
                            HeightRequest="150">

                        <VerticalStackLayout Padding="20"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Spacing="8">

                            <Label Text="[   BARCODE   ]"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />

                            <Label Text="Richt de barcode in het kader"
                                   FontSize="13"
                                   TextColor="Gray"
                                   HorizontalOptions="Center" />

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Border>

            
            <VerticalStackLayout Spacing="8">

                <Label Text="Barcode handmatig invoeren"
                       FontAttributes="Bold" />

                <Entry x:Name="BarcodeEntry"
                       Placeholder="Bijv. PKT10002349" />

                <Button Text="Pakket scannen"
                        BackgroundColor="#5A31F4"
                        TextColor="White"
                        Clicked="ScanPakket_Clicked" />

            </VerticalStackLayout>

            
            <Border Stroke="#E0E0E0"
                    StrokeThickness="1">

                <VerticalStackLayout Padding="16" Spacing="10">

                    <Label x:Name="AantalLabel"
                           Text="Gescande pakketten (0/36)"
                           FontAttributes="Bold" />

                    <CollectionView x:Name="PakkettenList"
                                    HeightRequest="220">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Border Stroke="#E0E0E0"
                                        StrokeThickness="1"
                                        Margin="0,4">

                                    <Grid Padding="12"
                                          ColumnDefinitions="*,Auto">

                                        <Label Text="{Binding Barcode}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />

                                        <Label Text="Gescand"
                                               Grid.Column="1"
                                               TextColor="Green"
                                               VerticalOptions="Center" />

                                    </Grid>
                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Border>

            <Button Text="Verder naar route overzicht"
                    BackgroundColor="#5A31F4"
                    TextColor="White"
                    HeightRequest="50"
                    Clicked="GoToRouteOverzichtPage" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>