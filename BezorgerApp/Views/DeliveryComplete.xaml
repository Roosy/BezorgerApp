<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BezorgerApp.Views.DeliveryComplete"
             Title="Levering compleet">
    
    <!-- met de caveat dat ik op zn minst nog wel datetime kan toevoegen-->
    
    <VerticalStackLayout Padding="20">
        <TableView Intent="Data" HorizontalOptions="Center">
            <TableRoot>
                <TableSection Title="Levering Voltooid!">
                    <TextCell Text="Jan Jansen" />
                    <TextCell Text="Kerkstraat 12"/>
                    <TextCell Text="13:02"/>
                </TableSection>
            </TableRoot>
        </TableView>

        <Button
            Text="Naar volgende levering"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Clicked="GoToDeliveryRegistration"></Button>

        <!-- deze knop moet verwijderd worden, en de "volgende levering" vervangen-->
        <Button
            Text="Rit Afronden"
            Margin="8"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Clicked="GoToRitAfrondenPage"></Button>
    </VerticalStackLayout>
</ContentPage>