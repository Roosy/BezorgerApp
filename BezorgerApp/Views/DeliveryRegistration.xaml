<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BezorgerApp.Views.DeliveryRegistration"
             Title="Levering Registreren">
    
    <VerticalStackLayout Padding="20" Spacing="20">
        <VerticalStackLayout Padding="0">
            <Label 
            Text="Kerkstraat 12"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

            <Label
            Text="6131AX Sittard"
            FontSize="10"
            VerticalOptions="Center"
            HorizontalOptions="Center" />

            <Label
            Text="Klant: Jan Jansen"
            FontSize="12"
            VerticalOptions="Center"
            HorizontalOptions="Center" />
        </VerticalStackLayout>
        
        <!--listview voor pakketjes list als we een db hebben hiervoor?-->

        <Border Stroke="#E0E0E0"
                    StrokeThickness="1">

            <VerticalStackLayout Padding="16" Spacing="10">

                <Label x:Name="AantalLabel"
                           Text="Pakketten"
                           FontAttributes="Bold" />

                <CollectionView x:Name="PakkettenList"
                                    HeightRequest="220">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border Stroke="#E0E0E0"
                                        StrokeThickness="1"
                                        Margin="0,4">

                                <Grid Padding="12"
                                          ColumnDefinitions="*,Auto">

                                    <Label Text="{Binding Barcode}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />

                                    <Label Text="Gescand"
                                               Grid.Column="1"
                                               TextColor="Green"
                                               VerticalOptions="Center" />

                                </Grid>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </Border>

        <Border Stroke="#E0E0E0"
                    StrokeThickness="1">

            <VerticalStackLayout Padding="16" Spacing="12">

                <Label Text="Barcode scanner"
                           FontAttributes="Bold"
                           FontSize="18" />

                <Border Stroke="#D0D0D0"
                            StrokeThickness="1"
                            StrokeDashArray="4,4"
                            HeightRequest="150">

                    <VerticalStackLayout Padding="20"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Spacing="8">

                        <Label Text="[   BARCODE   ]"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />

                        <Label Text="Richt de barcode in het kader"
                                   FontSize="13"
                                   TextColor="Gray"
                                   HorizontalOptions="Center" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </Border>


        <VerticalStackLayout Spacing="8">

            <Label Text="Barcode handmatig invoeren"
                       FontAttributes="Bold" />

            <Entry x:Name="BarcodeEntry"
                       Placeholder="Bijv. PKT10002349" />

            <Button Text="Pakket scannen"
                        BackgroundColor="#5A31F4"
                        TextColor="White"
                        Clicked="ScanPakket_Clicked" />

        </VerticalStackLayout>

        <!--Deze in een grid (en betere kleuren skull emoji):-->
        
        <Button
            Text="Levering Concluderen"
            BackgroundColor="Green"
            VerticalOptions="End"
            HorizontalOptions="End"
            Clicked="GoToDeliveryComplete"></Button>

        <Button
            Text="Probleem melden"
            BackgroundColor="Red"
            VerticalOptions="End"
            HorizontalOptions="End"
            Clicked="GoToProbleemMeldingPage"></Button>

    </VerticalStackLayout>
</ContentPage> 